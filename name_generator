chain : dict[str, dict] = {}


def _build_chain() -> None:
    for name in names:
        current_name : str = ""

        for i in range(order):
            current_name += START_TOKEN
        current_name += name.lower()

        for i in range(len(current_name) - order):
            key : str = ""

            for j in range(order):
                key += current_name[i + j]

            next_letter : str = current_name[i + order]

            if key not in chain:
                chain[key] = {}
                chain[key][next_letter] = WEIGHT_INCREMENT
            else:
                if next_letter not in chain[key]:
                    chain[key][next_letter] = WEIGHT_INCREMENT
                else:
                    chain[key][next_letter] = chain[key][next_letter] + WEIGHT_INCREMENT


def _generate_name() -> str:
    character_count : int = 0
    generated_name : str = ""

    key : str = ""
    for _i in range(order):
        key += START_TOKEN

    while character_count < max_char_length:
    
        if key not in chain:
            break

        next_letter : str = _get_next_letter(key)

        if next_letter == NULL_TOKEN:
            if character_count > min_char_length:
                break
            else:
                while next_letter == NULL_TOKEN:
                    next_letter = _get_next_letter(key)

        generated_name += next_letter
        key = key[1:] + next_letter
        character_count += 1

    return generated_name.capitalize()


def _get_next_letter(key : str) -> str:
    possible_next_letters : dict[str, int] = chain[key]

    letters : list[str] = list(possible_next_letters.keys())
    weights : list[int] = list(possible_next_letters.values())

    next_letter = random.choices(letters, weights)

    return next_letter[0]




