_build_chain()


while 1:
    print("Generated name: %s" % _generate_name())
    sentinel = input("Continue? %s/%s: " % (CONTINUE_TOKEN, BREAK_TOKEN))
    
    if sentinel.upper() == CONTINUE_TOKEN:
        continue
    elif sentinel.upper() == BREAK_TOKEN:
        break
    
